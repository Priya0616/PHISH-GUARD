# GEMINI_API_KEY: Required for server-side Gemini Explainable Threat Assessment.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for SOC analyst session tokens (generate a 32+ char random string).
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING"

# Optional External Threat Intelligence API Keys (Server-side only)
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""
URLHAUS_AUTH_KEY=""

# Optional SQLite Database Path (defaults to ./data/phishguard.db)
PHISHGUARD_DB_PATH="./data/phishguard.db"
